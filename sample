import numpy as np
import math

GRID_SPACING = 5.0
GRID_HALF_EXTENT = 500.0  # domain half-width. SI: "simulated region was a
                           # square with a side length of 1000, which is
                           # much larger than the typical final radius of
                           # the colonies (~200)" -- must stay this large
                           # so the boundary condition doesn't distort the
                           # growing colony.

_n_points = int(2 * GRID_HALF_EXTENT / GRID_SPACING) + 1
GRID_COORDS = np.linspace(-GRID_HALF_EXTENT, GRID_HALF_EXTENT, _n_points)
N_BINS = len(GRID_COORDS) - 1

# Diffusion/reaction parameters (SI Section 1.2 text, nondimensional units)
Dn = 250.0      # nutrient diffusion
ALPHA_N = 1.0   # nutrient consumption rate
KAPPA = 0.333   # nutrient sensitivity -- must match cell_sim.py's KAPPA
Dc = 1000.0     # interaction chemical diffusion
BETA_C = 10.0   # interaction chemical degradation


def new_nutrient_field():
    # starts fully saturated everywhere, matching a colony that hasn't
    # depleted anything yet
    return np.ones((N_BINS, N_BINS))


def new_chemical_field():
    return np.zeros((N_BINS, N_BINS))


def compute_density(cells, cell_area_fn, species_filter=None):
    """
    rho at each grid cell = (total area of cells centered in that grid
    cell) / (grid cell area). species_filter=None sums both species
    (used for nutrient consumption); species_filter=0 or 1 restricts to
    that species' producers (used for interaction chemicals).
    """
    xs, ys, areas = [], [], []
    for c in cells:
        if species_filter is not None and c[5] != species_filter:
            continue
        xs.append(c[0])
        ys.append(c[1])
        areas.append(cell_area_fn(c))

    if not xs:
        return np.zeros((N_BINS, N_BINS))

    hist, _, _ = np.histogram2d(xs, ys, bins=[GRID_COORDS, GRID_COORDS], weights=areas)
    grid_cell_area = GRID_SPACING ** 2
    return hist / grid_cell_area


def _laplacian(field):
    lap = np.zeros_like(field)
    lap[1:-1, 1:-1] = (
        field[2:, 1:-1] + field[:-2, 1:-1] +
        field[1:-1, 2:] + field[1:-1, :-2] -
        4 * field[1:-1, 1:-1]
    ) / GRID_SPACING ** 2
    return lap


def _safe_substeps(D, dt):
    """How many diffusion sub-steps are needed to stay numerically
    stable for a given diffusion constant and the outer particle dt."""
    stability_limit = GRID_SPACING ** 2 / (4 * D)
    if dt <= stability_limit:
        return 1
    return int(math.ceil(dt / stability_limit))


def step_nutrient(n_field, rho_total, dt):
    """SI Eq. 20: dn/dt = Dn*laplacian(n) - alpha_n*rho*n/(kappa+n)."""
    from math import isfinite
    n_substeps = _safe_substeps(Dn, dt)
    sub_dt = dt / n_substeps
    for _ in range(n_substeps):
        lap = _laplacian(n_field)
        consumption = ALPHA_N * rho_total * n_field / (KAPPA + n_field)
        n_field = n_field + (Dn * lap - consumption) * sub_dt
        n_field[0, :] = 1.0
        n_field[-1, :] = 1.0
        n_field[:, 0] = 1.0
        n_field[:, -1] = 1.0
        n_field = np.clip(n_field, 0.0, None)
    return n_field


def step_chemical(c_field, rho_producer, dt):
    """SI Eq. 21: dc/dt = Dc*laplacian(c) - beta_c*c + rho_producer."""
    n_substeps = _safe_substeps(Dc, dt)
    sub_dt = dt / n_substeps
    for _ in range(n_substeps):
        lap = _laplacian(c_field)
        c_field = c_field + (Dc * lap - BETA_C * c_field + rho_producer) * sub_dt
        c_field[0, :] = 0.0
        c_field[-1, :] = 0.0
        c_field[:, 0] = 0.0
        c_field[:, -1] = 0.0
        c_field = np.clip(c_field, 0.0, None)
    return c_field


def lookup(field, x, y):
    """Nearest-bin field value at a physical (x, y) position."""
    ix = int((x + GRID_HALF_EXTENT) / GRID_SPACING)
    iy = int((y + GRID_HALF_EXTENT) / GRID_SPACING)
    ix = min(max(ix, 0), N_BINS - 1)
    iy = min(max(iy, 0), N_BINS - 1)
    return field[ix, iy]
